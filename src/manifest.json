{
  "manifest_version": 2,
  "name": "Alias Buddy for SimpleLogin",
  "version": "0.3.1",
  "description": "Send as a SimpleLogin alias to normal addresses, the add-on handles the reverse aliases. Blocks messages that would reveal your real address. Not affiliated with Proton AG or SimpleLogin.",
  "author": "HyperCriSiS",
  "browser_specific_settings": {
    "gecko": {
      "id": "aliasbuddy@hypercrisis",
      "strict_min_version": "153.0"
    }
  },
  "icons": { "64": "icons/icon.svg" },
  "permissions": [
    "compose",
    "compose.send",
    "accountsRead",
    "accountsIdentities",
    "messagesRead",
    "addressBooks",
    "storage",
    "notifications",
    "https://app.simplelogin.io/*"
  ],
  "optional_permissions": ["*://*/*"],
  "background": { "page": "background.html" },
  "compose_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Alias Buddy",
    "default_label": "Alias Buddy",
    "default_popup": "popup/popup.html"
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "experiment_apis": {
    "aliasBuddyCompose": {
      "schema": "api/aliasBuddyCompose/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["aliasBuddyCompose"]],
        "script": "api/aliasBuddyCompose/implementation.js"
      }
    },
    "aliasBuddyItip": {
      "schema": "api/aliasBuddyItip/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["aliasBuddyItip"]],
        "script": "api/aliasBuddyItip/implementation.js",
        "events": ["startup"]
      }
    }
  }
}
